

NODE_ENV=development
PORT=5000

# Frontend origin — required for CORS + links inside emails
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Database (REQUIRED for anything to actually work)
# MongoDB Atlas free tier is fine — it's a replica set, which this backend
# needs (auth uses a multi-document transaction on register).
# ---------------------------------------------------------------------------
MONGO_URI=

# ---------------------------------------------------------------------------
# JWT — generate real random values, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The dev fallback values in code are NOT safe for anything but local testing.
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ---------------------------------------------------------------------------
# Email (SMTP) — leave blank in dev: emails are logged to the server console
# instead of sent, so the register/verify/reset flows are still fully
# testable without this.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@skillsphere.local

# ---------------------------------------------------------------------------
# Google OAuth — /api/auth/google returns 501 until these are set.
# Create credentials at https://console.cloud.google.com/apis/credentials
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ---------------------------------------------------------------------------
# One-time admin seed (run: npm run seed:admin) — public registration can
# only create client/freelancer accounts, by design.
# ---------------------------------------------------------------------------
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Not used yet (wired in later phases) — listed now so the full credential
# list is known up front:
# ---------------------------------------------------------------------------
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# STRIPE_SECRET_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# HUGGINGFACE_API_KEY=
